<Window x:Class="Oopz.Native.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Oopz · 原生客户端"
 Width="1020" Height="676" MinWidth="680" MinHeight="430" WindowStartupLocation="CenterScreen"
 FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Background="#191B22" Foreground="#F1F1F5"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
   <Style TargetType="Button">
     <Setter Property="Background" Value="#363A49"/><Setter Property="Foreground" Value="#FAFAFF"/>
     <Setter Property="Padding" Value="12,7"/><Setter Property="BorderThickness" Value="0"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
       <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="5"
               BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
         <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
       </Border>
       <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#A8A3FF"/></Trigger>
         <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger>
         <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.55"/></Trigger>
       </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="ListBox">
     <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F1F1F5"/>
     <Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
     <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
   </Style>
   <Style TargetType="ListBoxItem">
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,6"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <Border x:Name="Box" Padding="{TemplateBinding Padding}" Margin="0,1" CornerRadius="4"
               BorderThickness="1" BorderBrush="Transparent" Background="Transparent"><ContentPresenter/></Border>
       <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#2E313F"/></Trigger>
         <Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="#3B3953"/></Trigger>
         <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#B3ACFF"/></Trigger>
       </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
   </Style>
 </Window.Resources>
 <Grid>
   <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#20222C" BorderBrush="#353744" BorderThickness="0,0,0,1" Padding="20,0">
     <DockPanel LastChildFill="False">
       <TextBlock Text="Oopz" FontFamily="Segoe UI" FontWeight="Bold" FontSize="27" VerticalAlignment="Center"/>
       <Button x:Name="ConnectButton" AutomationProperties.AutomationId="ConnectButton" DockPanel.Dock="Right" Click="Connect_Click" VerticalAlignment="Center" Content="连接适配器…" Background="#534B98"/>
       <Button DockPanel.Dock="Right" Click="Import_Click" VerticalAlignment="Center" Content="打开网页记录…" Margin="0,0,8,0"/>
     </DockPanel>
   </Border>
   <Grid Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#22252F" Padding="12,12">
       <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Text="域" Foreground="#C3C3D2" Margin="4,0,0,6"/>
         <ComboBox Grid.Row="1" x:Name="Areas" AutomationProperties.Name="域" DisplayMemberPath="Name" SelectionChanged="Area_Changed" MinHeight="28"/>
         <TextBlock Grid.Row="2" Text="频道" Foreground="#C3C3D2" Margin="4,20,0,4"/>
         <ListBox Grid.Row="3" x:Name="Channels" AutomationProperties.AutomationId="Channels" AutomationProperties.Name="频道" DisplayMemberPath="Label" SelectionChanged="Channel_Changed"/>
         <Button Grid.Row="4" AutomationProperties.AutomationId="MicrophoneCheck" Content="麦克风自检…" Click="Mic_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
       </Grid>
     </Border>
     <Grid Grid.Column="1" Margin="22,16">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock x:Name="RoomTitle" Text="消息" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <Grid Grid.Row="1" Margin="0,10">
         <ListBox x:Name="Timeline" AutomationProperties.AutomationId="Timeline" AutomationProperties.Name="消息记录" ScrollViewer.ScrollChanged="Timeline_Scrolled">
           <ListBox.ItemTemplate><DataTemplate>
             <StackPanel><StackPanel Orientation="Horizontal">
               <TextBlock Text="{Binding Author}" Foreground="#C9C5FF" FontWeight="SemiBold"/>
               <TextBlock Text="{Binding Clock}" Margin="10,1,0,0" FontSize="12" Foreground="#ACAEBC"/>
             </StackPanel><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3,0,4"/></StackPanel>
           </DataTemplate></ListBox.ItemTemplate>
         </ListBox>
         <TextBlock x:Name="Empty" Text="连接本机适配器以收发频道消息，或打开自己保存的 Oopz 网页记录。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C3C3D2" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
       </Grid>
       <DockPanel x:Name="ComposeBar" Grid.Row="2" Visibility="Collapsed">
         <Button x:Name="SendMessage" DockPanel.Dock="Right" AutomationProperties.AutomationId="SendMessage" Content="发送" Click="Send_Click" Background="#534B98" Margin="8,0,0,0"/>
         <TextBox x:Name="Composer" AutomationProperties.AutomationId="Composer" AutomationProperties.Name="输入频道消息" MaxLength="4000" TextWrapping="Wrap" VerticalContentAlignment="Center" VerticalScrollBarVisibility="Auto" MinHeight="36" MaxHeight="90" Padding="8,4" Background="#272A35" Foreground="White" CaretBrush="White" BorderBrush="#666878" KeyDown="Composer_KeyDown" TextChanged="Composer_Changed"/>
       </DockPanel>
     </Grid>
   </Grid>
   <Border Grid.Row="2" Background="#20222C" BorderBrush="#353744" BorderThickness="0,1,0,0" Padding="14,6">
     <TextBlock x:Name="Status" Text="未连接" Foreground="#C3C3D2" TextWrapping="Wrap" FontSize="12"/>
   </Border>
 </Grid>
</Window>
