{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oopz",
  "version": "0.2.0",
  "identifier": "com.ktclat.oopz",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Oopz",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
        "url": "https://web.oopz.cn/",
        "zoomHotkeysEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
