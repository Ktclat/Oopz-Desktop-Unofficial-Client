{
  "$schema": "../gen/schemas/desktop-capability.json",
  "identifier": "default",
  "description": "Oopz 主窗口权限配置",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:tray:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:menu:default",
    "allow-global" 
  ]
}